#Comparing all models
loo_comparison <- do.call(loo::loo_compare, loo_model)

#Summarizing results

loo_df <- as.data.frame(loo_comparison) %>%
  tibble::rownames_to_column("model_name") %>%
  mutate(
    model_index = as.numeric(gsub("model", "", model_name)),
    diff_se_ratio = elpd_diff / se_diff,
    # Optional: add absolute ratio
    abs_ratio = abs(diff_se_ratio),
    # Optional: add significance indicator (common thresholds)
    significance = case_when(
      abs(diff_se_ratio) > 2 ~ "Strong evidence (|t|>2)",
      abs(diff_se_ratio) > 1.64 ~ "Moderate evidence (|t|>1.64)",
      abs(diff_se_ratio) > 1.28 ~ "Weak evidence (|t|>1.28)",
      TRUE ~ "No evidence"
    ),
    # Optional: add p-value approximation (two-tailed)
    p_value_approx = 2 * pnorm(-abs(diff_se_ratio)),
    rank = row_number()
  ) %>%
  select(rank, model_index, model_name, elpd_diff, se_diff, diff_se_ratio, 
         abs_ratio, significance, p_value_approx, everything())

