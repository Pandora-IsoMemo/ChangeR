# Function to detect outliers using rolling MAD
detect_outliers_rolling <- function(x, time_window = 5, threshold = 3) {
  # Calculate rolling median
  roll_median <- rollapply(x, width = time_window, FUN = median, 
                          fill = NA, align = "center")
  
  # Calculate rolling MAD
  roll_mad <- rollapply(x, width = time_window, FUN = function(y) {
    mad(y, constant = 1.4826)
  }, fill = NA, align = "center")
  
  # Calculate absolute deviation from rolling median
  abs_dev <- abs(x - roll_median)
  
  # Identify outliers (adjust threshold as needed)
  outliers <- abs_dev > (threshold * roll_mad) & !is.na(roll_mad)
  
  return(outliers)
}

